# Template for apps/backend/.env.dev on the NAS's *second* checkout (the dev
# environment). Real file is NAS-only, never committed — see .gitignore.
#
# RESEND_API_KEY and ORDERS_EMAIL_* are deliberately left unset: those
# subsystems no-op without them (see email.service.ts / email-orders sync in
# index.ts), so testing on dev never sends a real invitation email or touches
# the real orders inbox.

DATABASE_URL="postgresql://user:password@localhost:5434/jacaero"
PORT=3000
JWT_SECRET="change-me-32-characters-minimum"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
CORS_ORIGIN="https://dev.plataforma.caero.group"
FRONTEND_URL="https://dev.plataforma.caero.group"
INVITATION_EXPIRES_IN_DAYS=7
DOCS_ROOT_PATH="\\HAKO\personal_folder\J.A. CAERO S.L"
SEED_ADMIN_EMAIL="leo@caero.group"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_FULLNAME="Admin"
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY="change-me"
VAPID_PRIVATE_KEY="change-me"
VAPID_SUBJECT="mailto:admin@example.com"
